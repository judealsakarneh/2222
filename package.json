{
  "name": "ramble-motion",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion motion projects: the ramble. product film (1080x1920) and a square After Effects style demo reel.",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "studio": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts RambleAd out/ramble.mp4",
    "build:reel": "remotion render src/index.ts AEDemoReel out/demo-reel.mp4",
    "still": "remotion still src/index.ts RambleAd out/ramble-thumbnail.png",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade",
    "build:teaser": "remotion render src/index.ts ZambleTeaser out/zamble-teaser.mp4",
    "build:long": "remotion render src/index.ts LongTake out/zamble-longtake.mp4",
    "build:screen": "remotion render src/index.ts ScreenCut out/zamble-screencut.mp4",
    "build:story": "remotion render src/index.ts ZambleStory out/zamble-story.mp4",
    "build:quad": "remotion render src/index.ts ZambleQuad out/zamble-quad.mp4",
    "build:demo": "remotion render src/index.ts ZambleDemo out/zamble-demo-4k.mp4 --scale=2",
    "build:ctrl": "remotion render src/index.ts CtrlPromo out/ctrl-room-promo.mp4 --codec=h264 --crf=18",
    "build:flow": "remotion render src/index.ts CtrlFlow out/ctrl-flow.mp4 --codec=h264 --crf=17"
  },
  "dependencies": {
    "@remotion/cli": "4.0.516",
    "@remotion/google-fonts": "4.0.516",
    "@remotion/tailwind": "4.0.516",
    "framer-motion": "11.18.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.516"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
